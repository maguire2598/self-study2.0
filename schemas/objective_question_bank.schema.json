{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObjectiveQuestionBank",
  "description": "具有标准答案的课程客观题库，与旧版状态定位题库相互独立。",
  "type": "object",
  "$defs": {
    "cDiagramId": {
      "enum": [
        "cp-c-velocity-plane-quadrants", "cp-c-velocity-plane-initial", "cp-c-velocity-plane-terminal", "cp-c-velocity-plane-state-vs-path",
        "cp-c-energy-ellipse-equal-mass", "cp-c-energy-ellipse-ratio-4", "cp-c-energy-ellipse-ratio-16", "cp-c-energy-ellipse-same-energy",
        "cp-c-scale-pair-equal-mass", "cp-c-scale-pair-ratio-4", "cp-c-scale-pair-ratio-16", "cp-c-scale-pair-ratio-100", "cp-c-scale-pair-error-check",
        "cp-c-momentum-chord-ratio-1", "cp-c-momentum-chord-ratio-4", "cp-c-momentum-chord-ratio-16", "cp-c-momentum-chord-parallel", "cp-c-momentum-chord-intersections",
        "cp-c-wall-reflection-basic", "cp-c-wall-reflection-axis-check", "cp-c-wall-reflection-radius",
        "cp-c-state-chain-ratio-4", "cp-c-state-chain-ratio-9", "cp-c-state-chain-ratio-16", "cp-c-state-chain-ratio-100", "cp-c-state-chain-terminal",
        "cp-c-safe-sector-ratio-4", "cp-c-safe-sector-ratio-16", "cp-c-safe-sector-boundary",
        "cp-c-equal-angle-chord", "cp-c-equal-angle-step", "cp-c-equal-angle-count", "cp-c-element-legend-overview",
        "cp-c-wedge-unfold-basic", "cp-c-wedge-unfold-mirror", "cp-c-wedge-unfold-count"
      ]
    },
    "visiblePhysicsFact": {
      "oneOf": [
        { "$ref": "#/$defs/visibleMassRatioFact" },
        { "$ref": "#/$defs/visibleSafeSectorBoundaryFact" },
        { "$ref": "#/$defs/visibleMomentumValueSetFact" },
        { "$ref": "#/$defs/visibleOriginRelationFact" }
      ]
    },
    "visibleMassRatioFact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "mass_large", "mass_small"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "kind": { "const": "mass_ratio" },
        "mass_large": { "type": "number", "exclusiveMinimum": 0 },
        "mass_small": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "visibleSafeSectorBoundaryFact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "mass_large", "mass_small", "coefficient", "notation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "kind": { "const": "safe_sector_boundary" },
        "mass_large": { "type": "number", "exclusiveMinimum": 0 },
        "mass_small": { "type": "number", "exclusiveMinimum": 0 },
        "coefficient": { "type": "number", "exclusiveMinimum": 0 },
        "notation": { "enum": ["equation", "interval"] }
      }
    },
    "visibleMomentumValueSetFact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "values", "notation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "kind": { "const": "momentum_value_set" },
        "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "number" } },
        "notation": { "enum": ["symbol", "zero_words"] }
      }
    },
    "visibleOriginRelationFact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "relation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "kind": { "const": "origin_relation" },
        "relation": { "enum": ["passes_origin", "does_not_pass_origin", "mixed_or_not_asserted"] }
      }
    },
    "visiblePhysicsFigureBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["figure_ref", "momentum_values"],
      "properties": {
        "figure_ref": { "$ref": "#/$defs/cDiagramId" },
        "momentum_values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "number" } }
      }
    },
    "visiblePhysicsContract": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt_template", "explanation_template", "facts"],
      "properties": {
        "prompt_template": { "type": "string", "minLength": 1 },
        "explanation_template": { "type": "string", "minLength": 1 },
        "facts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/visiblePhysicsFact" } },
        "figure_bindings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/visiblePhysicsFigureBinding" } }
      }
    },
    "option": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "enum": ["A", "B", "C", "D"] },
        "text": { "type": "string" },
        "figure_ref": { "$ref": "#/$defs/cDiagramId" },
        "option_accessibility_label": { "enum": ["图A", "图B", "图C", "图D"] },
        "embedded_figure_aria_hidden": { "const": true }
      }
    }
  },
  "required": ["course_id", "section_id", "version", "content_fingerprint", "question_count_by_node", "delivery_policy", "status_assessment", "questions"],
  "properties": {
    "course_id": { "type": "string" },
    "section_id": { "enum": ["A", "B", "C"] },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "content_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "question_count_by_node": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "delivery_policy": {
      "type": "object",
      "required": ["reveal_answer_after_wrong", "wrong_answer_action", "correct_answer_actions"],
      "properties": {
        "reveal_answer_after_wrong": { "const": false },
        "wrong_answer_action": { "const": "error_followup_agent" },
        "correct_answer_actions": {
          "type": "array",
          "prefixItems": [
            { "const": "next_question" },
            { "const": "error_followup_agent" }
          ],
          "items": false
        }
      }
    },
    "status_assessment": {
      "type": "object",
      "required": ["enabled"],
      "properties": { "enabled": { "const": false } }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "node_id", "node_title", "question_type", "question_style",
          "assessment_kind", "difficulty", "prompt", "event_stage", "variant_axis",
          "explanation", "enabled", "revision"
        ],
        "properties": {
          "id": { "type": "string" },
          "node_id": { "type": "string", "pattern": "^[ABC]" },
          "node_title": { "type": "string" },
          "question_type": { "enum": ["single_choice", "multiple_choice", "multi_blank"] },
          "question_style": { "enum": ["scenario", "calculation", "concise"] },
          "difficulty": { "enum": [1, 2, 3] },
          "scenario_id": { "type": "string" },
          "event_stage": {
            "enum": [
              "initial", "after_first_collision", "after_wall_collision",
              "after_second_collision", "terminal", "special_case", "extension_stage",
              "state_analysis", "calculation"
            ]
          },
          "variant_axis": {
            "enum": [
              "mass_ratio", "initial_velocity", "friction", "elasticity", "incline", "spring",
              "system_boundary", "counting", "direction", "observation", "model_assumption", "event_sequence",
              "conservation", "energy", "equation_setup", "impulse", "limit", "restitution", "solution_method", "state_geometry",
              "coordinate_transform", "angle_counting", "legend", "momentum", "wall_reflection", "elective_method", "calculation"
            ]
          },
          "calculation_fixture_id": { "type": "string", "minLength": 1 },
          "presentation_mode": { "enum": ["text_only", "stem_figure", "option_figures", "figure_sequence"] },
          "figure_refs": { "type": "array", "items": { "$ref": "#/$defs/cDiagramId" } },
          "diagram_focus": { "type": "string" },
          "anonymous_option_rendering": {
            "type": "object",
            "additionalProperties": false,
            "required": ["embedded_figure_aria_hidden", "accessible_name_source"],
            "properties": {
              "embedded_figure_aria_hidden": { "const": true },
              "accessible_name_source": { "const": "option_accessibility_label" }
            }
          },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "assessment_kind": { "const": "objective" },
          "prompt": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {
                "allOf": [
                  { "$ref": "#/$defs/option" },
                  { "properties": { "id": { "const": "A" } } }
                ]
              },
              {
                "allOf": [
                  { "$ref": "#/$defs/option" },
                  { "properties": { "id": { "const": "B" } } }
                ]
              },
              {
                "allOf": [
                  { "$ref": "#/$defs/option" },
                  { "properties": { "id": { "const": "C" } } }
                ]
              },
              {
                "allOf": [
                  { "$ref": "#/$defs/option" },
                  { "properties": { "id": { "const": "D" } } }
                ]
              }
            ],
            "items": false
          },
          "correct_answers": {
            "type": "array",
            "items": { "enum": ["A", "B", "C", "D"] }
          },
          "blanks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "accepted_answers"],
              "properties": {
                "id": { "type": "string" },
                "accepted_answers": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              }
            }
          },
          "explanation": { "type": "string" },
          "enabled": { "type": "boolean" },
          "revision": { "type": "integer", "minimum": 0 },
          "author_notes": { "type": "string" },
          "visible_physics_contract": { "$ref": "#/$defs/visiblePhysicsContract" }
        },
        "allOf": [
          {
            "if": { "properties": { "question_type": { "const": "single_choice" } } },
            "then": {
              "required": ["options", "correct_answers"],
              "properties": {
                "correct_answers": { "minItems": 1, "maxItems": 1 }
              },
              "not": { "required": ["blanks"] }
            }
          },
          {
            "if": { "properties": { "question_type": { "const": "multiple_choice" } } },
            "then": {
              "required": ["options", "correct_answers"],
              "properties": {
                "correct_answers": {
                  "minItems": 2,
                  "maxItems": 2,
                  "uniqueItems": true
                }
              },
              "not": { "required": ["blanks"] }
            }
          },
          {
            "if": { "properties": { "question_type": { "const": "multi_blank" } } },
            "then": {
              "required": ["blanks"],
              "not": {
                "anyOf": [
                  { "required": ["options"] },
                  { "required": ["correct_answers"] }
                ]
              }
            }
          },
          {
            "if": { "properties": { "question_style": { "const": "calculation" } } },
            "then": { "required": ["calculation_fixture_id"] }
          },
          {
            "if": { "allOf": [{ "required": ["presentation_mode"] }, { "properties": { "presentation_mode": { "const": "option_figures" } } }] },
            "then": {
              "required": ["options", "anonymous_option_rendering"],
              "properties": {
                "options": {
                  "prefixItems": [
                    { "required": ["figure_ref", "option_accessibility_label", "embedded_figure_aria_hidden"], "properties": { "option_accessibility_label": { "const": "图A" }, "embedded_figure_aria_hidden": { "const": true } } },
                    { "required": ["figure_ref", "option_accessibility_label", "embedded_figure_aria_hidden"], "properties": { "option_accessibility_label": { "const": "图B" }, "embedded_figure_aria_hidden": { "const": true } } },
                    { "required": ["figure_ref", "option_accessibility_label", "embedded_figure_aria_hidden"], "properties": { "option_accessibility_label": { "const": "图C" }, "embedded_figure_aria_hidden": { "const": true } } },
                    { "required": ["figure_ref", "option_accessibility_label", "embedded_figure_aria_hidden"], "properties": { "option_accessibility_label": { "const": "图D" }, "embedded_figure_aria_hidden": { "const": true } } }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "section_id": { "const": "A" } }, "required": ["section_id"] },
      "then": {
        "properties": {
          "questions": {
            "minItems": 140,
            "maxItems": 140,
            "items": {
              "properties": {
                "node_id": {
                  "enum": [
                    "A1.1", "A1.2", "A1.3", "A2.1", "A2.2",
                    "A3.1", "A3.2", "A3.3", "A3.4", "A3.5",
                    "A4.1", "A4.2", "A4.3", "A5.1", "A5.2",
                    "A6.1", "A6.2", "A7.1", "A7.2", "A7.3"
                  ]
                },
                "event_stage": { "enum": ["initial", "after_first_collision", "after_wall_collision", "after_second_collision", "terminal", "special_case", "extension_stage"] },
                "variant_axis": { "not": { "enum": ["coordinate_transform", "angle_counting", "legend", "momentum", "wall_reflection", "elective_method", "calculation"] } }
              }
            }
          },
          "question_count_by_node": {
            "minProperties": 20,
            "maxProperties": 20,
            "propertyNames": {
              "enum": [
                "A1.1", "A1.2", "A1.3", "A2.1", "A2.2",
                "A3.1", "A3.2", "A3.3", "A3.4", "A3.5",
                "A4.1", "A4.2", "A4.3", "A5.1", "A5.2",
                "A6.1", "A6.2", "A7.1", "A7.2", "A7.3"
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "section_id": { "const": "B" } }, "required": ["section_id"] },
      "then": {
        "properties": {
          "questions": {
            "minItems": 168,
            "maxItems": 168,
            "items": {
              "properties": {
                "node_id": {
                  "enum": [
                    "B1.1", "B1.2", "B1.3", "B1.4",
                    "B2.1", "B2.2", "B2.3", "B2.4",
                    "B3.1", "B3.2", "B3.3", "B3.4", "B3.5",
                    "B4.1", "B4.2", "B4.3", "B4.4", "B4.5",
                    "B5.1", "B5.2", "B5.3", "B5.4"
                  ]
                },
                "event_stage": { "enum": ["initial", "after_first_collision", "after_wall_collision", "after_second_collision", "terminal", "special_case", "extension_stage"] },
                "variant_axis": { "not": { "enum": ["coordinate_transform", "angle_counting", "legend", "momentum", "wall_reflection", "elective_method", "calculation"] } }
              }
            }
          },
          "question_count_by_node": {
            "minProperties": 22,
            "maxProperties": 22,
            "propertyNames": {
              "enum": [
                "B1.1", "B1.2", "B1.3", "B1.4",
                "B2.1", "B2.2", "B2.3", "B2.4",
                "B3.1", "B3.2", "B3.3", "B3.4", "B3.5",
                "B4.1", "B4.2", "B4.3", "B4.4", "B4.5",
                "B5.1", "B5.2", "B5.3", "B5.4"
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "section_id": { "const": "C" } }, "required": ["section_id"] },
      "then": {
        "properties": {
          "questions": {
            "minItems": 180,
            "maxItems": 180,
            "items": {
              "properties": {
                "node_id": {
                  "enum": [
                    "C1.1", "C1.2", "C1.3", "C1.4", "C2.1", "C2.2", "C2.3",
                    "C3.1", "C3.2", "C3.3", "C3.4", "C3.5", "C4.1", "C4.2", "C4.3", "C4.4",
                    "C5.1", "C5.2", "C5.3", "C6.1", "C6.2", "C6.3", "C6.4", "C7.1", "C7.2", "C7.3", "C7.4",
                    "C8.1", "C8.2", "C8.3", "C9.1", "C9.2", "C9.3", "C9.4", "C9.5", "C9.6", "C9.7"
                  ]
                }
              }
            }
          },
          "question_count_by_node": {
            "minProperties": 37,
            "maxProperties": 37,
            "propertyNames": {
              "enum": [
                "C1.1", "C1.2", "C1.3", "C1.4", "C2.1", "C2.2", "C2.3",
                "C3.1", "C3.2", "C3.3", "C3.4", "C3.5", "C4.1", "C4.2", "C4.3", "C4.4",
                "C5.1", "C5.2", "C5.3", "C6.1", "C6.2", "C6.3", "C6.4", "C7.1", "C7.2", "C7.3", "C7.4",
                "C8.1", "C8.2", "C8.3", "C9.1", "C9.2", "C9.3", "C9.4", "C9.5", "C9.6", "C9.7"
              ]
            }
          }
        }
      }
    }
  ]
}
