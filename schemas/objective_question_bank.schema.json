{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObjectiveQuestionBank",
  "description": "具有标准答案的课程客观题库，与旧版状态定位题库相互独立。",
  "type": "object",
  "$defs": {
    "option": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "enum": ["A", "B", "C", "D"] },
        "text": { "type": "string" }
      }
    }
  },
  "required": ["course_id", "section_id", "version", "content_fingerprint", "question_count_by_node", "delivery_policy", "status_assessment", "questions"],
  "properties": {
    "course_id": { "type": "string" },
    "section_id": { "enum": ["A", "B"] },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "content_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "question_count_by_node": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "delivery_policy": {
      "type": "object",
      "required": ["reveal_answer_after_wrong", "wrong_answer_action", "correct_answer_actions"],
      "properties": {
        "reveal_answer_after_wrong": { "const": false },
        "wrong_answer_action": { "const": "error_followup_agent" },
        "correct_answer_actions": {
          "type": "array",
          "prefixItems": [
            { "const": "next_question" },
            { "const": "error_followup_agent" }
          ],
          "items": false
        }
      }
    },
    "status_assessment": {
      "type": "object",
      "required": ["enabled"],
      "properties": { "enabled": { "const": false } }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "node_id", "node_title", "question_type", "question_style",
          "assessment_kind", "difficulty", "prompt", "event_stage", "variant_axis",
          "explanation", "enabled", "revision"
        ],
        "properties": {
          "id": { "type": "string" },
          "node_id": { "type": "string", "pattern": "^[AB]" },
          "node_title": { "type": "string" },
          "question_type": { "enum": ["single_choice", "multiple_choice", "multi_blank"] },
          "question_style": { "enum": ["scenario", "calculation", "concise"] },
          "difficulty": { "enum": [1, 2, 3] },
          "scenario_id": { "type": "string" },
          "event_stage": {
            "enum": [
              "initial", "after_first_collision", "after_wall_collision",
              "after_second_collision", "terminal", "special_case", "extension_stage"
            ]
          },
          "variant_axis": {
            "enum": [
              "mass_ratio", "initial_velocity", "friction", "elasticity", "incline", "spring",
              "system_boundary", "counting", "direction", "observation", "model_assumption", "event_sequence",
              "conservation", "energy", "equation_setup", "impulse", "limit", "restitution", "solution_method", "state_geometry"
            ]
          },
          "calculation_fixture_id": { "type": "string", "minLength": 1 },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "assessment_kind": { "const": "objective" },
          "prompt": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {
                "allOf": [
                  { "$ref": "#/$defs/option" },
                  { "properties": { "id": { "const": "A" } } }
                ]
              },
              {
                "allOf": [
                  { "$ref": "#/$defs/option" },
                  { "properties": { "id": { "const": "B" } } }
                ]
              },
              {
                "allOf": [
                  { "$ref": "#/$defs/option" },
                  { "properties": { "id": { "const": "C" } } }
                ]
              },
              {
                "allOf": [
                  { "$ref": "#/$defs/option" },
                  { "properties": { "id": { "const": "D" } } }
                ]
              }
            ],
            "items": false
          },
          "correct_answers": {
            "type": "array",
            "items": { "enum": ["A", "B", "C", "D"] }
          },
          "blanks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "accepted_answers"],
              "properties": {
                "id": { "type": "string" },
                "accepted_answers": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              }
            }
          },
          "explanation": { "type": "string" },
          "enabled": { "type": "boolean" },
          "revision": { "type": "integer", "minimum": 0 },
          "author_notes": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "question_type": { "const": "single_choice" } } },
            "then": {
              "required": ["options", "correct_answers"],
              "properties": {
                "correct_answers": { "minItems": 1, "maxItems": 1 }
              },
              "not": { "required": ["blanks"] }
            }
          },
          {
            "if": { "properties": { "question_type": { "const": "multiple_choice" } } },
            "then": {
              "required": ["options", "correct_answers"],
              "properties": {
                "correct_answers": {
                  "minItems": 2,
                  "maxItems": 2,
                  "uniqueItems": true
                }
              },
              "not": { "required": ["blanks"] }
            }
          },
          {
            "if": { "properties": { "question_type": { "const": "multi_blank" } } },
            "then": {
              "required": ["blanks"],
              "not": {
                "anyOf": [
                  { "required": ["options"] },
                  { "required": ["correct_answers"] }
                ]
              }
            }
          },
          {
            "if": { "properties": { "question_style": { "const": "calculation" } } },
            "then": { "required": ["calculation_fixture_id"] }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "section_id": { "const": "A" } }, "required": ["section_id"] },
      "then": {
        "properties": {
          "questions": {
            "minItems": 140,
            "maxItems": 140,
            "items": {
              "properties": {
                "node_id": {
                  "enum": [
                    "A1.1", "A1.2", "A1.3", "A2.1", "A2.2",
                    "A3.1", "A3.2", "A3.3", "A3.4", "A3.5",
                    "A4.1", "A4.2", "A4.3", "A5.1", "A5.2",
                    "A6.1", "A6.2", "A7.1", "A7.2", "A7.3"
                  ]
                }
              }
            }
          },
          "question_count_by_node": {
            "minProperties": 20,
            "maxProperties": 20,
            "propertyNames": {
              "enum": [
                "A1.1", "A1.2", "A1.3", "A2.1", "A2.2",
                "A3.1", "A3.2", "A3.3", "A3.4", "A3.5",
                "A4.1", "A4.2", "A4.3", "A5.1", "A5.2",
                "A6.1", "A6.2", "A7.1", "A7.2", "A7.3"
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "section_id": { "const": "B" } }, "required": ["section_id"] },
      "then": {
        "properties": {
          "questions": {
            "minItems": 168,
            "maxItems": 168,
            "items": {
              "properties": {
                "node_id": {
                  "enum": [
                    "B1.1", "B1.2", "B1.3", "B1.4",
                    "B2.1", "B2.2", "B2.3", "B2.4",
                    "B3.1", "B3.2", "B3.3", "B3.4", "B3.5",
                    "B4.1", "B4.2", "B4.3", "B4.4", "B4.5",
                    "B5.1", "B5.2", "B5.3", "B5.4"
                  ]
                }
              }
            }
          },
          "question_count_by_node": {
            "minProperties": 22,
            "maxProperties": 22,
            "propertyNames": {
              "enum": [
                "B1.1", "B1.2", "B1.3", "B1.4",
                "B2.1", "B2.2", "B2.3", "B2.4",
                "B3.1", "B3.2", "B3.3", "B3.4", "B3.5",
                "B4.1", "B4.2", "B4.3", "B4.4", "B4.5",
                "B5.1", "B5.2", "B5.3", "B5.4"
              ]
            }
          }
        }
      }
    }
  ]
}
